{
  "compilerOptions": {
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "strictNullChecks": false,
    "noImplicitAny": false,
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"]
  },
  "include": ["src/js/**/*.js", "src/js/**/*.d.ts"]
}
